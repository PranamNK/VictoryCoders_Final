# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/templeverse

# MongoDB Atlas (Cloud) - use this for production
# Replace username, password, and cluster details with your actual credentials
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/templeverse?appName=Cluster0

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Use a strong, random string (at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# CORS Configuration
# Frontend URL for CORS
CLIENT_URL=http://localhost:8080
